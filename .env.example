# Backend API URL — get this from CDK deploy output: cd infra && npm run deploy
EXPO_PUBLIC_API_URL=https://your-api-id.execute-api.us-west-2.amazonaws.com/prod

# App Environment (dev/prod)
EXPO_PUBLIC_APP_ENV=dev

# Apple ID for eas submit
EXPO_APPLE_ID=your-apple-id@example.com

# NOTE: The WSF API key is NOT an app env var. It lives server-side in the CDK
# backend (passed as the WsfApiKey deploy parameter) and the app reaches WSF
# through the backend /wsf proxy — so the key never ships in the app bundle.
#
# Personal home/work locations and check-in contact number are entered in the
# app's Settings screen and stored on-device (AsyncStorage); not configured here.
