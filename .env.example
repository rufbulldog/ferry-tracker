# WSF API Access Code
# Register at https://wsdot.wa.gov/traffic/api/ to get your key
EXPO_PUBLIC_WSF_API_KEY=your_api_access_code_here

# Backend API URL
# Get this from CDK deploy output: cd infra && npm run deploy
EXPO_PUBLIC_API_URL=https://your-api-id.execute-api.us-west-2.amazonaws.com/prod

# App Environment (dev/prod)
EXPO_PUBLIC_APP_ENV=dev
