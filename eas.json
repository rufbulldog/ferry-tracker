{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "dev",
        "EXPO_PUBLIC_API_URL": "https://yv8hqe5rgc.execute-api.us-west-2.amazonaws.com/prod"
      },
      "ios": {
        "simulator": false
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "prod",
        "EXPO_PUBLIC_API_URL": "https://yv8hqe5rgc.execute-api.us-west-2.amazonaws.com/prod"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "prod",
        "EXPO_PUBLIC_API_URL": "https://yv8hqe5rgc.execute-api.us-west-2.amazonaws.com/prod"
      },
      "ios": {
        "autoIncrement": true
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "production"
    }
  }
}
