{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "dev",
        "EXPO_PUBLIC_API_URL": "https://yv8hqe5rgc.execute-api.us-west-2.amazonaws.com/prod"
      },
      "ios": {
        "simulator": false
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "prod",
        "EXPO_PUBLIC_API_URL": "https://yv8hqe5rgc.execute-api.us-west-2.amazonaws.com/prod"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "prod",
        "EXPO_PUBLIC_API_URL": "https://yv8hqe5rgc.execute-api.us-west-2.amazonaws.com/prod"
      },
      "ios": {
        "autoIncrement": true
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "REDACTED_ASC_APP_ID",
        "appleTeamId": "REDACTED_APPLE_TEAM_ID",
        "ascApiKeyPath": "./keys/AuthKey_REDACTED_ASC_KEY_ID.p8",
        "ascApiKeyId": "REDACTED_ASC_KEY_ID",
        "ascApiKeyIssuerId": "REDACTED_ASC_KEY_ISSUER_ID"
      }
    }
  }
}
